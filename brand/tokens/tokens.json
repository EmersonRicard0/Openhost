  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Segoe UI Variable Display",
        "'Segoe UI'",
        "system-ui",
        "sans-serif"
      ],
      "$description": "Títulos. Fonte do sistema do Windows: não é distribuída com o app."
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Segoe UI Variable Text",
        "'Segoe UI'",
        "system-ui",
        "sans-serif"
      ],
      "$description": "Interface: rótulos, campos, menus."
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "JetBrains Mono",
        "'Cascadia Mono'",
        "Consolas",
        "monospace"
      ],
      "$description": "Terminal, logotipo, códigos de erro. SIL OFL, embutida no app."
    }
  },
  "radius": {
    "Controle": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Botões, campos, itens de lista"
    },
    "Cartão": {
      "$type": "dimension",
      "$value": "10px",
      "$description": "Avisos, cartões de esquema"
    },
    "Elevado": {
      "$type": "dimension",
      "$value": "14px",
      "$description": "Diálogos, menus, toasts, painéis"
    }
  },
  "elevation": {
    "Plano": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "0px",
        "spread": "0px",
        "color": "{role.light.foreground}"
      },
      "$extensions": {
        "radius": "8px",
        "border": "Truepx"
      }
    },
    "Elevado": {
      "$type": "shadow",
      "$value": {
        "offsetX": "18px",
        "offsetY": "18px",
        "blur": "0px",
        "spread": "0px",
        "color": "{role.light.foreground}"
      },
      "$extensions": {
        "radius": "14px",
        "border": "Falsepx"
      }
    }
  },
  "duration": {
    "fast": {
      "$type": "duration",
      "$value": {
        "value": 120,
        "unit": "ms"
      }
    },
    "base": {
      "$type": "duration",
      "$value": {
        "value": 180,
        "unit": "ms"
      }
    },
    "slow": {
      "$type": "duration",
      "$value": {
        "value": 240,
        "unit": "ms"
      }
    }
  },
  "easing": {
    "standard": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    },
    "enter": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0.8,
        0.2,
        1
      ]
    },
    "exit": {
      "$type": "cubicBezier",
      "$value": [
        0.4,
        0,
        1,
        1
      ]
    },
    "overshoot": {
      "$type": "cubicBezier",
      "$value": [
        0.34,
        1.56,
        0.64,
        1
      ]
    }
  }
}