{
  "name": "shellvault",
  "version": "0.1.0",
  "description": "Cliente SSH desktop local-first com cofre criptografado",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "electron-vite build && playwright test",
    "test:secrets-scan": "electron-vite build && playwright test tests/e2e/secrets-scan.spec.ts",
    "test:sshd:up": "node scripts/sshd.mjs up",
    "test:sshd:down": "node scripts/sshd.mjs down",
    "test:sshd:rotate-key": "node scripts/sshd.mjs rotate-key",
    "seed:hosts": "node scripts/seed-hosts.mjs",
    "bench:sftp": "node scripts/bench-sftp.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:wails": "node scripts/check.mjs",
    "dist": "electron-vite build && electron-builder --win --x64",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "libsodium-wrappers-sumo": "^0.8.4",
    "node-pty": "1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ssh2": "1.17",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64",
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "electron@45.0.0": true,
    "node-pty@1.1.0": true,
    "ssh2@1.17.0": true
  }
}
