{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.tsc/test",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"]
  },
  "include": [
    "tests/**/*",
    "scripts/**/*",
    "src/**/*",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
